{
  "name": "laqta",
  "version": "1.0.0",
  "description": "High-frequency flash discount and pricing error detector for Amazon & Noon",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "recon": "tsx scripts/recon.ts",
    "solve": "tsx scripts/solve.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dev": "tsx src/server/api.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/static": "^10.1.11",
    "better-sqlite3": "^13.1.1",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.8",
    "lucide-react": "^1.74.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^7.23.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.11.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.3.8",
    "vitest": "^4.1.0"
  }
}
